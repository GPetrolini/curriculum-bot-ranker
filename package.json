{
  "name": "whatsapp-pdf-scanner",
  "version": "1.0.0",
  "description": "Bot de WhatsApp para download automático de currículos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "pdf",
    "scanner",
    "electron"
  ],
  "author": "Natã Batista",
  "license": "MIT",
  "dependencies": {
    "whatsapp-web.js": "^1.23.0",
    "pg": "^8.11.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "electron": "^27.0.0",
    "jest": "^29.7.0",
    "@cucumber/cucumber": "^10.3.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "database/**/*.js",
      "services/**/*.js",
      "bot-service.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
